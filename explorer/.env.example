# Copy to .env in the directory from which the application starts.
# Use plain KEY=value entries without shell quotes or export.
# OS environment variables take precedence over this file.
DB_URL=jdbc:postgresql://postgres:5432/explorer
DB_USERNAME=postgres
DB_PASSWORD=
JWT_SECRET=
GOOGLE_API_KEY=

# Docker Compose overrides service URLs with container hostnames.
DB_NAME=explorer
DB_PORT=5433
BACKEND_PORT=8080
FRONTEND_PORT=3000
RECOMMENDER_PORT=8001
POSTGRES_VOLUME_NAME=explorer_pgdata
FRONTEND_PATH=D:/4th course/diploma/frontend
RECOMMENDER_PATH=../travel-recommender-service
# Browser-visible Maps JavaScript API key.
VITE_GOOGLE_MAPS_API_KEY=
VITE_DISABLE_GOOGLE_API=false
